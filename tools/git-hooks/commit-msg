#!/bin/sh
# Removes AI-assistant attribution trailers so every commit carries only the author's own name.
# Installed by tools/setup.ps1 or tools/setup.sh (git config core.hooksPath tools/git-hooks).
msg="$1"
tmp="$msg.paravent-tmp"
grep -viE '^[[:space:]]*(co-authored-by:.*(claude|anthropic|noreply@anthropic\.com)|claude-session:|.*generated with \[?claude( code)?\]?)' "$msg" > "$tmp" || true
# drop trailing blank lines left behind
awk 'NF{for(i=0;i<blank;i++)print ""; blank=0; print; next} {blank++}' "$tmp" > "$msg"
rm -f "$tmp"
